{
  "name": "@hoox-sh/hoox-tui",
  "version": "0.1.8",
  "description": "Hoox algorithmic trading terminal operations center — OpenTUI dashboard",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "bun": "./src/main.tsx",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "hoox-tui": "bin/hoox-tui.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "bun run src/main.tsx",
    "build": "bun build src/main.tsx --outdir dist --target bun --packages external",
    "start": "bun run bin/hoox-tui.js",
    "test": "bun test --preload ./src/test-setup.ts",
    "test:e2e": "bun test --preload ./src/test-setup.ts test/e2e/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@hoox-sh/hoox-shared": "workspace:*",
    "@opentui-ui/dialog": "^0.1.2",
    "@opentui-ui/toast": "^0.0.5",
    "@opentui/core": "^0.4.1",
    "@opentui/react": "^0.4.1",
    "immer": "^11.1.8",
    "react": "^19.2.6",
    "smol-toml": "^1.6.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@hoox/test-utils": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoox-sh/hoox.git",
    "directory": "packages/tui"
  },
  "keywords": [
    "hoox",
    "tui",
    "opentui",
    "terminal",
    "trading",
    "cloudflare"
  ],
  "author": "jango-blockchained (hoox-sh)"
}
