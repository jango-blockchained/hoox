      },
      {
        "header": "Community",
        "items": [
          {
            "label": "GitHub Repository",
            "href": "https://github.com/hoox-sh/hoox-setup"
          },
          {
            "label": "Support",
            "href": "mailto:support@hoox.sh"
          },
          {
            "label": "Telegram Bot",
            "href": "/docs/enduser/tutorials/telegram-bot"
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "docs/openapi-minimal.yaml",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required",
      "prefill": true
    },
    "params": {
      "expanded": "all"
    }
