{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Hoox",
  "description": "Edge-Native Algorithmic Trading on the Cloudflare Edge. Free, open-source framework for trade signal ingestion, risk management, and execution at the edge.",
  "colors": {
    "primary": "#F97316",
    "light": "#FB923C",
    "dark": "#EA580C"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/dark.svg",
    "dark": "/logo/light.svg",
    "href": "https://github.com/hoox-sh/hoox-setup"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Hoox Documentation",
      "og:title": "Hoox — Edge-Native Algorithmic Trading on the Cloudflare Edge",
      "og:description": "Free, open-source algorithmic trading framework deployed natively to the Cloudflare Edge Network. Trade signals, risk management, and execution in milliseconds.",
      "og:type": "website",
      "og:locale": "en_US",
      "og:image": "/og-image.png",
      "twitter:card": "summary_large_image",
      "twitter:site": "@hoox",
      "twitter:title": "Hoox Documentation",
      "twitter:description": "Edge-Native Algorithmic Trading on the Cloudflare Edge. Free, open-source framework for trade signal ingestion, risk management, and execution at the edge.",
      "twitter:image": "/og-image.png",
      "canonical": "https://docs.hoox.sh",
      "robots": "index, follow"
    }
  },
  "search": {
    "prompt": "Search the Hoox docs..."
  },
  "metadata": {
    "timestamp": true
  },
  "banner": {
    "type": "info",
    "content": "Hoox is open-source software for algorithmic trading on the Cloudflare edge. Trading carries risk — test on staging first.",
    "dismissible": true
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/hoox-sh/hoox-setup"
    }
  },
  "footerSocials": {
    "github": "https://github.com/hoox-sh/hoox-setup"
  },
  "footer": {
    "links": [
      {
        "header": "End User",
        "items": [
          {
            "label": "Installation",
            "href": "/docs/enduser/getting-started/installation"
          },
          {
            "label": "Quick Start",
            "href": "/docs/enduser/getting-started/quick-start"
          },
          {
            "label": "Test Trading",
            "href": "/docs/enduser/guides/test-trading"
          },
          {
            "label": "CLI Reference",
            "href": "/docs/enduser/reference/cli-commands"
          }
        ]
      },
      {
        "header": "Platform",
        "items": [
          {
            "label": "Architecture",
            "href": "/docs/devops/architecture"
          },
          {
            "label": "Workers",
            "href": "/docs/devops/workers"
          },
          {
            "label": "DevOps",
            "href": "/docs/devops"
          },
          {
            "label": "API",
            "href": "/docs/devops/api"
          },
          {
            "label": "Enterprise",
            "href": "/docs/enterprise"
          }
